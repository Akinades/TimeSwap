# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.cntipi5.mongodb.net/timeswap?retryWrites=true&w=majority
MONGODB_DB=timeswap
PORT=3001

# Bootstraps the first admin account in MongoDB (only when users collection is empty)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-strong-password
AUTH_SECRET=generate-a-long-random-string

# Optional: only if frontend is hosted separately from the API
# VITE_API_BASE=https://your-api.example.com/api
