# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/timeswap?retryWrites=true&w=majority
MONGODB_DB=timeswap

# Railway / Render set PORT automatically — local default:
PORT=3001

# Bootstraps the first admin (only when users collection is empty)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-strong-password
AUTH_SECRET=generate-a-long-random-string

# Same-origin hosting (Railway/Render): leave VITE_API_BASE unset
# Frontend calls /api on the same host after `npm run build && npm start`

# Only if frontend is on a different host (e.g. GitHub Pages):
# VITE_API_BASE=https://your-api.example.com/api
# VITE_BASE=/TimeSwap/
